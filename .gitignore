# Loksewa AI App — Comprehensive .gitignore
# ─────────────────────────────────────────────────────────────────────────────

# ─── Android / Gradle ────────────────────────────────────────────────────────
.gradle/
.kotlin/
build/
app/build/
apps/mobile/build/
apps/mobile/.dart_tool/
apps/mobile/.flutter-plugins
apps/mobile/.flutter-plugins-dependencies
apps/mobile/.packages
apps/mobile/pubspec.lock
*.apk
*.aab
*.ap_
*.dex
*.class
local.properties
*.iml
.cxx/

# Android Studio IDE files
.idea/
*.xml
!app/src/**/*.xml
!database/schema.sql
!.github/**/*.xml

# Keystore / signing
*.jks
*.keystore
keystore.properties

# ─── Python / Backend ────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.pyo
*.pyd
.env
.env.*
!backend/.env.example
!backend/.env.development
!backend/.env.test
!backend/.env.production.example
venv/
.venv/
env/
*.egg-info/
dist/
.pytest_cache/
.coverage
htmlcov/

# ─── SQLite databases (runtime only) ─────────────────────────────────────────
runtime/
*.db
*.db-journal
*.db-shm
*.db-wal
*.sqlite
*.sqlite3

# Do NOT ignore the seed database asset
!app/src/main/assets/loksewa_v1.db.gz

# ─── Node / Monorepo ─────────────────────────────────────────────────────────
node_modules/
**/node_modules/
backend/dist/
admin-dashboard/node_modules/
admin-dashboard/.next/
admin-dashboard/dist/
apps/web/.next/
apps/web/out/
apps/admin-dashboard/dist/
services/*/dist/
services/*/node_modules/
packages/*/dist/
packages/*/node_modules/
.turbo/
*.tsbuildinfo

# ─── OS / Editor ─────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
*.swp
*.swo
*~
.vscode/
*.log

# ─── Secrets / Keys ──────────────────────────────────────────────────────────
*.pem
*.p8
*.p12
secrets.yaml
secrets.json
google-services.json
GoogleService-Info.plist

# ─── Large media files ───────────────────────────────────────────────────────
*.zip
*.tar.gz
stitch_*.zip
loksewa-ai-platform-v1.zip
repomix-output.xml

# ─── Temp / Generated ────────────────────────────────────────────────────────
.mavis/
.opencode/
settings.gradle.bak
*.bak
