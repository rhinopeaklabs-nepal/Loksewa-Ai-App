{
  "name": "qa",
  "version": "1.0.0",
  "description": "Centralized QA framework for Loksewa AI",
  "scripts": {
    "test:web": "cd e2e-web && npx playwright test",
    "test:api": "cd e2e-api && npx playwright test",
    "test:perf": "cd performance && k6 run load-test.js",
    "report:generate": "npx allure generate ./allure-results -o ./allure-report --clean",
    "report:open": "npx allure open ./allure-report"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@types/k6": "^2.0.0",
    "allure-commandline": "^2.42.0",
    "allure-playwright": "^3.9.0",
    "eslint": "^10.4.1",
    "prettier": "^3.8.3",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.3"
  }
}
