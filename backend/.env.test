NODE_ENV=test
LOKSEWA_ENV=test
HOST=127.0.0.1
PORT=0
LOG_LEVEL=silent

NODE_BACKEND_DB_PATH=../runtime/node-backend-test.json
ADMIN_DIST_PATH=../admin-dashboard/dist

LOKSEWA_ADMIN_TOKEN=test-admin-token
LOKSEWA_SESSION_SECRET=test-session-secret
LOKSEWA_DELTA_SIGNING_SECRET=test-delta-signing-secret
LOKSEWA_BOOTSTRAP_ADMIN_EMAIL=admin@loksewa.local
LOKSEWA_BOOTSTRAP_ADMIN_PASSWORD=LoksewaAdmin@Test123
SESSION_TTL_HOURS=2
LOKSEWA_TRUST_PROXY=true
LOKSEWA_ENFORCE_HTTPS=false
LOKSEWA_ENABLE_ARCHITECTURE_ROUTES=true
REQUEST_BODY_LIMIT_BYTES=131072
RATE_LIMIT_MAX=1000
RATE_LIMIT_WINDOW=1 minute
AUTH_RATE_LIMIT_MAX=100
AUTH_RATE_LIMIT_WINDOW=1 minute

LOKSEWA_CORS_ORIGINS=http://127.0.0.1:8000

LOKSEWA_SCRAPER_ENABLED=false
SCRAPER_INTERVAL_MS=3600000
LOKSEWA_SCRAPER_REQUEST_TIMEOUT_MS=12000
LOKSEWA_SCRAPER_USER_AGENT=LoksewaAIStudyBot/0.1 (+https://localhost; test)
