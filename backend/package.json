{
  "name": "loksewa-ai-backend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "dev:once": "tsx src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "start:prod": "node dist/index.js",
    "test": "npm run build && node tests/app.test.mjs",
    "test:watch": "npm test",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm test",
    "render:build": "npm ci --include=dev && npm run build && npm prune --omit=dev",
    "render:start": "npm run start:prod",
    "prisma:generate": "prisma generate"
  },
  "engines": {
    "node": ">=22.0.0 <23.0.0",
    "npm": ">=10.0.0"
  },
  "packageManager": "npm@10.9.3",
  "dependencies": {
    "@anthropic-ai/sdk": "^0.60.0",
    "@fastify/cors": "^11.0.1",
    "@fastify/env": "^5.0.3",
    "@fastify/jwt": "^10.0.0",
    "@fastify/rate-limit": "^10.3.0",
    "@fastify/swagger": "^9.5.1",
    "@fastify/swagger-ui": "^5.2.3",
    "@prisma/client": "^6.10.1",
    "argon2": "^0.44.0",
    "bullmq": "^5.56.4",
    "dotenv": "^17.2.1",
    "eventemitter2": "^6.4.9",
    "fastify": "^5.4.0",
    "ioredis": "^5.6.1",
    "jsonwebtoken": "^9.0.2",
    "openai": "^5.11.0",
    "pino": "^9.7.0",
    "uuid": "^11.1.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^24.1.0",
    "prisma": "^6.10.1",
    "tsc-watch": "^7.1.1",
    "tsx": "^4.20.3",
    "typescript": "^5.8.3"
  }
}
