NODE_ENV=development
LOKSEWA_ENV=development
HOST=127.0.0.1
PORT=8000
LOG_LEVEL=info

NODE_BACKEND_DB_PATH=../runtime/node-backend-dev.json
ADMIN_DIST_PATH=../admin-dashboard/dist

LOKSEWA_ADMIN_TOKEN=dev-admin-token-change-me
LOKSEWA_SESSION_SECRET=dev-session-secret-change-me
LOKSEWA_DELTA_SIGNING_SECRET=dev-delta-signing-secret-change-me
LOKSEWA_BOOTSTRAP_ADMIN_EMAIL=admin@loksewa.local
LOKSEWA_BOOTSTRAP_ADMIN_PASSWORD=LoksewaAdmin@123
SESSION_TTL_HOURS=168
LOKSEWA_TRUST_PROXY=true
LOKSEWA_ENFORCE_HTTPS=false
LOKSEWA_ENABLE_ARCHITECTURE_ROUTES=true
REQUEST_BODY_LIMIT_BYTES=131072
RATE_LIMIT_MAX=600
RATE_LIMIT_WINDOW=1 minute
AUTH_RATE_LIMIT_MAX=10
AUTH_RATE_LIMIT_WINDOW=1 minute

LOKSEWA_CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000,http://127.0.0.1:5173,http://127.0.0.1:8000

LOKSEWA_SCRAPER_ENABLED=false
SCRAPER_INTERVAL_MS=3600000
LOKSEWA_SCRAPER_REQUEST_TIMEOUT_MS=12000
LOKSEWA_SCRAPER_USER_AGENT=LoksewaAIStudyBot/0.1 (+https://localhost; educational syllabus updater)

OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OLLAMA_URL=http://127.0.0.1:11434

DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/loksewa_ai?schema=public
REDIS_URL=redis://127.0.0.1:6379
