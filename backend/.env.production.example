NODE_ENV=production
LOKSEWA_ENV=production
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=info

NODE_BACKEND_DB_PATH=/data/node-backend-db.json
ADMIN_DIST_PATH=/app/admin-dashboard/dist

LOKSEWA_ADMIN_TOKEN=replace-with-a-long-random-admin-token
LOKSEWA_SESSION_SECRET=replace-with-a-long-random-session-secret
LOKSEWA_DELTA_SIGNING_SECRET=replace-with-a-long-random-delta-signing-secret
LOKSEWA_BOOTSTRAP_ADMIN_EMAIL=admin@example.com
LOKSEWA_BOOTSTRAP_ADMIN_PASSWORD=replace-with-a-long-random-admin-password
SESSION_TTL_HOURS=24
LOKSEWA_TRUST_PROXY=true
LOKSEWA_ENFORCE_HTTPS=true
LOKSEWA_ENABLE_ARCHITECTURE_ROUTES=false
REQUEST_BODY_LIMIT_BYTES=131072
RATE_LIMIT_MAX=120
RATE_LIMIT_WINDOW=1 minute
AUTH_RATE_LIMIT_MAX=10
AUTH_RATE_LIMIT_WINDOW=1 minute

LOKSEWA_CORS_ORIGINS=https://admin.example.com,https://api.example.com

LOKSEWA_SCRAPER_ENABLED=false
SCRAPER_INTERVAL_MS=3600000
LOKSEWA_SCRAPER_REQUEST_TIMEOUT_MS=12000
LOKSEWA_SCRAPER_USER_AGENT=LoksewaAIStudyBot/1.0 (+https://example.com/contact)

OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OLLAMA_URL=

DATABASE_URL=postgresql://user:password@postgres:5432/loksewa_ai?schema=public
REDIS_URL=redis://redis:6379
