generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  admin
  student
  moderator
  reviewer
}

enum SubscriptionStatus {
  active
  trialing
  past_due
  cancelled
  expired
}

enum SubscriptionPlanCode {
  free
  basic
  premium
}

enum QuestionDifficulty {
  easy
  medium
  hard
}

enum LearningLevel {
  beginner
  intermediate
  advanced
}

enum TutorMessageRole {
  user
  assistant
  system
}

enum TestAttemptStatus {
  in_progress
  submitted
  expired
}

enum ScanJobStatus {
  queued
  processing
  completed
  failed
}

model User {
  id                 String              @id @default(uuid())
  email              String              @unique
  passwordHash       String              @map("password_hash")
  name               String
  phone              String?
  avatarUrl          String?             @map("avatar_url")
  role               UserRole            @default(student)
  subscriptionId     String?             @map("subscription_id")
  createdAt          DateTime            @default(now()) @map("created_at")
  updatedAt          DateTime            @updatedAt @map("updated_at")
  sessions           Session[]
  scanJobs           ScanJob[]
  testAttempts       TestAttempt[]
  studyProgress      StudyProgress[]
  tutorConversations TutorConversation[]
  subscription       Subscription?

  @@map("users")
}

model Session {
  id           String    @id @default(uuid())
  userId       String    @map("user_id")
  refreshToken String    @map("refresh_token")
  expiresAt    DateTime  @map("expires_at")
  revokedAt    DateTime? @map("revoked_at")
  createdAt    DateTime  @default(now()) @map("created_at")
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model Subject {
  id        String   @id @default(uuid())
  name      String
  nameNp    String?  @map("name_np")
  icon      String?
  color     String?
  sortOrder Int      @default(0) @map("sort_order")
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  topics    Topic[]

  @@map("subjects")
}

model Topic {
  id            String          @id @default(uuid())
  subjectId     String          @map("subject_id")
  name          String
  nameNp        String?         @map("name_np")
  description   String?
  sortOrder     Int             @default(0) @map("sort_order")
  loksewaWeight Float           @default(0) @map("loksewa_weight")
  createdAt     DateTime        @default(now()) @map("created_at")
  subject       Subject         @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  subTopics     SubTopic[]
  questions     Question[]
  topicNotes    TopicNote[]
  studyProgress StudyProgress[]
  mockTests     MockTest[]

  @@map("topics")
}

model SubTopic {
  id        String     @id @default(uuid())
  topicId   String     @map("topic_id")
  name      String
  nameNp    String?    @map("name_np")
  sortOrder Int        @default(0) @map("sort_order")
  createdAt DateTime   @default(now()) @map("created_at")
  topic     Topic      @relation(fields: [topicId], references: [id], onDelete: Cascade)
  questions Question[]

  @@map("subtopics")
}

model Question {
  id               String             @id @default(uuid())
  topicId          String?            @map("topic_id")
  subtopicId       String?            @map("subtopic_id")
  questionText     String             @map("question_text")
  questionTextNp   String?            @map("question_text_np")
  questionImageUrl String?            @map("question_image_url")
  difficulty       QuestionDifficulty @default(medium)
  examYear         Int?               @map("exam_year")
  examType         String?            @map("exam_type")
  source           String?
  isVerified       Boolean            @default(false) @map("is_verified")
  verifiedBy       String?            @map("verified_by")
  verifiedAt       DateTime?          @map("verified_at")
  loksewaFrequency Int                @default(0) @map("loksewa_frequency")
  createdAt        DateTime           @default(now()) @map("created_at")
  updatedAt        DateTime           @updatedAt @map("updated_at")
  topic            Topic?             @relation(fields: [topicId], references: [id], onDelete: SetNull)
  subTopic         SubTopic?          @relation(fields: [subtopicId], references: [id], onDelete: SetNull)
  options          QuestionOption[]
  answers          Answer[]
  tags             QuestionTag[]
  aiLessons        AILesson[]
  testQuestions    TestQuestion[]
  flashcards       Flashcard[]

  @@map("questions")
}

model QuestionOption {
  id           String   @id @default(uuid())
  questionId   String   @map("question_id")
  optionLabel  String   @map("option_label")
  optionText   String   @map("option_text")
  optionTextNp String?  @map("option_text_np")
  isCorrect    Boolean  @default(false) @map("is_correct")
  sortOrder    Int      @default(0) @map("sort_order")
  question     Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@map("question_options")
}

model Answer {
  id          String    @id @default(uuid())
  questionId  String    @map("question_id")
  answerText  String    @map("answer_text")
  explanation String?
  source      String?
  sourceUrl   String?   @map("source_url")
  isVerified  Boolean   @default(false) @map("is_verified")
  verifiedBy  String?   @map("verified_by")
  verifiedAt  DateTime? @map("verified_at")
  question    Question  @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@map("answers")
}

model QuestionTag {
  id         String   @id @default(uuid())
  questionId String   @map("question_id")
  tag        String
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@map("question_tags")
}

model AILesson {
  id                   String        @id @default(uuid())
  questionId           String        @map("question_id")
  simpleExplanation    String        @map("simple_explanation")
  detailedExplanation  String        @map("detailed_explanation")
  examNotes            String        @map("exam_notes")
  mnemonic             String?
  relatedQuestionsJson String        @default("[]") @map("related_questions_json")
  topicSummary         String        @map("topic_summary")
  difficultyLevel      LearningLevel @default(beginner) @map("difficulty_level")
  generatedAt          DateTime      @default(now()) @map("generated_at")
  cacheKey             String        @unique @map("cache_key")
  version              Int           @default(1)
  question             Question      @relation(fields: [questionId], references: [id], onDelete: Cascade)
  flashcards           Flashcard[]

  @@map("ai_lessons")
}

model Flashcard {
  id             String    @id @default(uuid())
  questionId     String?   @map("question_id")
  lessonId       String?   @map("lesson_id")
  front          String
  back           String
  reviewCount    Int       @default(0) @map("review_count")
  lastReviewedAt DateTime? @map("last_reviewed_at")
  nextReviewAt   DateTime? @map("next_review_at")
  easeFactor     Float     @default(2.5) @map("ease_factor")
  interval       Int       @default(0)
  createdAt      DateTime  @default(now()) @map("created_at")
  question       Question? @relation(fields: [questionId], references: [id], onDelete: Cascade)
  lesson         AILesson? @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@map("flashcards")
}

model StudyProgress {
  id                   String        @id @default(uuid())
  userId               String        @map("user_id")
  topicId              String        @map("topic_id")
  completionPercentage Float         @default(0) @map("completion_percentage")
  questionsAttempted   Int           @default(0) @map("questions_attempted")
  questionsCorrect     Int           @default(0) @map("questions_correct")
  timeSpentMinutes     Int           @default(0) @map("time_spent_minutes")
  lastStudiedAt        DateTime?     @map("last_studied_at")
  streakDays           Int           @default(0) @map("streak_days")
  masteryLevel         LearningLevel @default(beginner) @map("mastery_level")
  createdAt            DateTime      @default(now()) @map("created_at")
  updatedAt            DateTime      @updatedAt @map("updated_at")
  user                 User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  topic                Topic         @relation(fields: [topicId], references: [id], onDelete: Cascade)

  @@unique([userId, topicId])
  @@map("study_progress")
}

model TutorConversation {
  id            String         @id @default(uuid())
  userId        String         @map("user_id")
  subjectId     String?        @map("subject_id")
  topicId       String?        @map("topic_id")
  title         String
  contextJson   String         @default("{}") @map("context_json")
  messageCount  Int            @default(0) @map("message_count")
  lastMessageAt DateTime?      @map("last_message_at")
  createdAt     DateTime       @default(now()) @map("created_at")
  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages      TutorMessage[]

  @@map("tutor_conversations")
}

model TutorMessage {
  id              String            @id @default(uuid())
  conversationId  String            @map("conversation_id")
  role            TutorMessageRole
  content         String
  attachmentsJson String            @default("[]") @map("attachments_json")
  createdAt       DateTime          @default(now()) @map("created_at")
  conversation    TutorConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@map("tutor_messages")
}

model ScanJob {
  id              String        @id @default(uuid())
  userId          String        @map("user_id")
  imageUrl        String?       @map("image_url")
  status          ScanJobStatus @default(queued)
  extractedText   String?       @map("extracted_text")
  matchedQuestion String?       @map("matched_question")
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")
  user            User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("scan_jobs")
}

model MockTest {
  id               String         @id @default(uuid())
  title            String
  description      String?
  subjectId        String?        @map("subject_id")
  questionCount    Int            @default(0) @map("question_count")
  timeLimitMinutes Int            @map("time_limit_minutes")
  difficultyMix    String         @default("{}") @map("difficulty_mix")
  isPremium        Boolean        @default(false) @map("is_premium")
  isActive         Boolean        @default(true) @map("is_active")
  createdAt        DateTime       @default(now()) @map("created_at")
  subject          Topic?         @relation(fields: [subjectId], references: [id], onDelete: SetNull)
  testQuestions    TestQuestion[]
  attempts         TestAttempt[]

  @@map("mock_tests")
}

model TestQuestion {
  id         String   @id @default(uuid())
  testId     String   @map("test_id")
  questionId String   @map("question_id")
  orderIndex Int      @default(0) @map("order_index")
  mockTest   MockTest @relation(fields: [testId], references: [id], onDelete: Cascade)
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([testId, questionId])
  @@map("test_questions")
}

model TestAttempt {
  id               String            @id @default(uuid())
  userId           String            @map("user_id")
  testId           String            @map("test_id")
  startedAt        DateTime          @default(now()) @map("started_at")
  completedAt      DateTime?         @map("completed_at")
  score            Float             @default(0)
  totalQuestions   Int               @default(0) @map("total_questions")
  correctAnswers   Int               @default(0) @map("correct_answers")
  timeTakenSeconds Int               @default(0) @map("time_taken_seconds")
  status           TestAttemptStatus @default(in_progress)
  resultsJson      String            @default("{}") @map("results_json")
  user             User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  mockTest         MockTest          @relation(fields: [testId], references: [id], onDelete: Cascade)

  @@map("test_attempts")
}

model TopicNote {
  id         String        @id @default(uuid())
  topicId    String        @map("topic_id")
  title      String
  content    String
  contentNp  String?       @map("content_np")
  level      LearningLevel @default(beginner)
  isVerified Boolean       @default(false) @map("is_verified")
  source     String?
  createdAt  DateTime      @default(now()) @map("created_at")
  updatedAt  DateTime      @updatedAt @map("updated_at")
  topic      Topic         @relation(fields: [topicId], references: [id], onDelete: Cascade)

  @@map("topic_notes")
}

model Plan {
  id            String         @id @default(uuid())
  name          String
  code          String         @unique
  price         Float          @default(0)
  currency      String         @default("NPR")
  durationDays  Int            @default(30) @map("duration_days")
  featuresJson  String         @default("[]") @map("features_json")
  isActive      Boolean        @default(true) @map("is_active")
  createdAt     DateTime       @default(now()) @map("created_at")
  subscriptions Subscription[]

  @@map("plans")
}

model Subscription {
  id        String             @id @default(uuid())
  userId    String             @unique @map("user_id")
  planId    String             @map("plan_id")
  status    SubscriptionStatus @default(active)
  startedAt DateTime           @default(now()) @map("started_at")
  expiresAt DateTime?          @map("expires_at")
  autoRenew Boolean            @default(false) @map("auto_renew")
  paymentId String?            @map("payment_id")
  user      User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan      Plan               @relation(fields: [planId], references: [id], onDelete: Restrict)
  payments  Payment[]

  @@map("subscriptions")
}

model Payment {
  id             String       @id @default(uuid())
  userId         String       @map("user_id")
  subscriptionId String       @map("subscription_id")
  amount         Float
  currency       String       @default("NPR")
  provider       String
  status         String
  createdAt      DateTime     @default(now()) @map("created_at")
  subscription   Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  @@map("payments")
}
